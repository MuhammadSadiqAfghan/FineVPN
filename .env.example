# این فایل فقط الگو است؛ برنامه آن را خودکار بارگذاری نمی‌کند.
# برای استقرار عمومی، رمز مدیر و SECRET_KEY اختصاصی تنظیم کنید.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-unique-password
SECRET_KEY=replace-with-a-random-64-character-secret
DATA_DIR=/app/data
PORT=8000
PUBLIC_BASE_URL=https://vpn.example.com
FINEVPN_LOGO_URL=https://i.ibb.co/23qKBjNv/copilot-image-1793563203439.png
COOKIE_SECURE=true
TRUSTED_PROXIES=
CORS_ORIGINS=
# برای تست زندهٔ موتور، باینری‌های xray و sing-box باید در PATH میزبان باشند.
