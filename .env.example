# 𝑭𝒊𝒏𝒆𝑽𝑷𝑵 1.0.0 — example environment
PORT=8000
DATA_DIR=/data

# Fresh install defaults to Admin / Admin when these are omitted.
# Set unique values before public exposure.
# ADMIN_USERNAME=Admin
# ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
# SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Set to 1 only once if you intentionally need to reset persisted credentials.
# Remove/unset it after the restart.
# ADMIN_PASSWORD_RESET=1

# Enable only behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=0
# TRUSTED_PROXIES=127.0.0.1,::1
# ALLOWED_PUBLIC_HOSTS=vpn.example.com

# Optional GitHub state persistence fallback (use a private repository and a restricted token).
# GH_PERSIST_TOKEN=
# GH_PERSIST_REPO=owner/private-repository
# GH_PERSIST_BRANCH=state
# GH_PERSIST_PATH=state/panel_state.json

# Optional hosting settings.
# RAILWAY_PUBLIC_DOMAIN=
# RAILWAY_VOLUME_MOUNT_PATH=/data
# CORS_ORIGINS=
# SESSION_TTL_SECONDS=2592000
